# Copy to .env (local dev) or set these as Vercel Project Environment
# Variables (Production + Preview) — see README.md → "Monthly anniversary
# emails" for the full setup walkthrough. Never commit a real .env file.

# Resend (https://resend.com) — API key from an account with a verified
# sending domain.
RESEND_API_KEY=
# Must be an address on that verified domain, e.g. "Us <hello@yourdomain.com>".
RESEND_FROM=

# JSON array of {id, name, email}. `id` is a stable key used for delivery
# dedup — changing it makes that recipient look "new" (re-sent this month).
ANNIVERSARY_RECIPIENTS=[{"id":"partner-a","name":"","email":""},{"id":"partner-b","name":"","email":""}]

# Public URL of the deployed gift site, used for the email button.
SITE_URL=https://your-deployed-site.example.com

# Random secret used to authenticate cron + dry-run calls to
# /api/monthaversary. Generate one with: openssl rand -hex 32
# When set, Vercel automatically sends it as `Authorization: Bearer <value>`
# on its own Cron invocations — you only need to pass it yourself for
# manual/dry-run calls.
CRON_SECRET=

# Provided automatically once a Vercel KV (Upstash Redis) store is linked to
# this project — no need to set these by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=
